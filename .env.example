# ========== 小米账号 ==========
# 小米账号（手机号 / 邮箱）与密码；首次登录可能需要短信验证码
MI_USER=
MI_PASS=
# 可选：抓包得到的 Cookie（有值时优先于账号密码）
MI_COOKIE=

# ========== 云端大模型（OpenAI 兼容）==========
# DeepSeek 示例：
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_API_BASE=https://api.deepseek.com/v1
#   OPENAI_MODEL=deepseek-chat
# OpenAI 官方示例：
#   OPENAI_API_BASE=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ========== 对话行为 ==========
# 触发词，逗号分隔；对音箱说「小爱同学，帮我……」才会转给大模型
KEYWORDS=帮我,请
# 追加给模型的提示（控制播报长度）
PROMPT=以下请用 300 字以内回答，请只回答文字不要带链接
# 持续对话起止口令
START_CONVERSATION=开始持续对话
END_CONVERSATION=结束持续对话
# HTTP 代理（可选），例如 http://127.0.0.1:7890
HTTP_PROXY=
# 日志详细程度：0 / 1 / 2
VERBOSE=1

# ========== 音箱：小爱音箱 Pro (LX06) ==========
LX06_DID=
LX06_HARDWARE=LX06
LX06_MUTE_XIAOAI=true
LX06_STREAM=true
LX06_USE_COMMAND=false

# ========== 音箱：Play 增强版 (L05C) ==========
L05C_DID=
L05C_HARDWARE=L05C
L05C_MUTE_XIAOAI=true
# L05C 不支持可靠的播放状态查询，必须关闭流式
L05C_STREAM=false
L05C_USE_COMMAND=true

# ========== Token 缓存路径（可选）==========
# 默认使用用户目录下的 .mi.token；Docker / 多账号时可改路径
# XIAOGPT_MI_TOKEN_PATH=

# ========== Windows 保活（任务计划 awam-mi-ai）==========
# 逗号分隔，决定 watchdog 拉起哪些音箱
MI_AI_DEVICES=LX06,L05C
# 崩溃重启退避：首次等待秒数、上限秒数（指数退避）
MI_AI_RESTART_BASE_SEC=5
MI_AI_RESTART_MAX_SEC=300
# 日志目录（相对项目根或绝对路径）、按天滚动保留天数
MI_AI_LOG_DIR=logs
MI_AI_LOG_KEEP_DAYS=7
